{
  "hosting": {
    "site": "longmacargo",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=300" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
